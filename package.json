{
  "name": "furnforge-ai",
  "version": "1.0.0",
  "description": "FurnForge AI - Sketch-to-Photoreal Furniture Renderer",
  "scripts": {
    "dev": "concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "start:backend": "cd backend && uvicorn app.main:app --host 0.0.0.0 --port 8005 --reload",
    "start:frontend": "cd frontend && npm run dev",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^9.2.5"
  },
  "author": "FurnForge AI Team",
  "license": "MIT"
}
