{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://furnforge-api.sooraj.fun/api/:path*"
    },
    {
      "source": "/outputs/:path*",
      "destination": "https://furnforge-api.sooraj.fun/outputs/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "https://furnforge-api.sooraj.fun/uploads/:path*"
    },
    {
      "source": "/sample_sketches/:path*",
      "destination": "https://furnforge-api.sooraj.fun/sample_sketches/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
