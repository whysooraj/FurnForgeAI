# FurnForge AI Server Environment Configuration
APP_NAME="FurnForge AI"
PORT=8000
HOST="0.0.0.0"
DEBUG=True

# AI Pipeline Options
# Models: runwayml/stable-diffusion-v1-5, stabilityai/stable-diffusion-2-1
SD_MODEL="runwayml/stable-diffusion-v1-5"
CONTROLNET_MODEL="lllyasviel/control_v11p_sd15_canny"

# Force Hybrid Demo Mode (True/False)
# If True, bypasses heavy HuggingFace weight downloads and runs high-fidelity OpenCV + CNN Neural Engine
FORCE_DEMO_MODE=False

# Image-to-3D Reconstruction
# Priority 1: stabilityai/TripoSR (supports CUDA GPU and CPU)
TRIPOSR_MODEL="stabilityai/TripoSR"
TRIPOSR_MC_RESOLUTION=192
TRIPOSR_CHUNK_SIZE=8192
TRIPOSR_BAKE_TEXTURE=True
TRIPOSR_TEXTURE_RESOLUTION=1024

# Priority 2 Fallback: tencent/Hunyuan3D-2mini (requires NVIDIA CUDA GPU >= 6GB VRAM)
HUNYUAN3D_MODEL="tencent/Hunyuan3D-2mini"
HUNYUAN3D_SUBFOLDER="hunyuan3d-dit-v2-mini"
HUNYUAN3D_ENABLE_TEXTURE=True